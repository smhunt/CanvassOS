# Copy to .env and fill in. Never commit .env.

# Public hostname — Caddy obtains a Let's Encrypt certificate for it (ports 80/443 must be reachable)
DOMAIN=canvass.sean-hunt.com

# Database password for the `canvass` role (docker-compose builds DATABASE_URL from it)
POSTGRES_PASSWORD=change-me-long-random

# Signs the session cookie. >= 32 random chars:  openssl rand -base64 48
SESSION_SECRET=change-me-at-least-32-random-characters

# First-boot admin: created ONLY when the app_user table is empty. Change the password after
# first login (Account -> change password); these two lines can then be removed from .env.
ADMIN_EMAIL=sean@ecoworks.ca
ADMIN_PASSWORD=change-me-min-10-chars

# Passphrase for `make backup` (gpg --symmetric AES-256). Keep it somewhere other than this server.
BACKUP_PASSPHRASE=change-me-backup-passphrase

# Optional
LOG_LEVEL=info

# Where sign photos are written (the compose stack sets this to the signphotos volume).
# Locally, leave unset and the API falls back to ./data/sign-photos.
# SIGN_PHOTO_DIR=/photos

# Street-level imagery of a door (OPTIONAL — absent means the feature is off, which is the default).
# A Google Cloud API key restricted to the Street View Static API AND to this server's egress IP
# (a referrer restriction does nothing for a server-side call). The key is never served to the
# browser, and only coordinates are ever sent to the provider — never a name or an address.
# Static Street View: 10,000 requests/month free, then US$7.00/1,000. Metadata is free and unlimited.
# Google's terms PROHIBIT storing the imagery, so nothing is cached server-side. See API.md.
#STREETVIEW_API_KEY=
#STREETVIEW_PROVIDER=google
