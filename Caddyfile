# Caddy: TLS (Let's Encrypt, automatic for $DOMAIN), static SPA from /srv, /api/* -> api:3000
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	log {
		output stdout
		format console
	}
}
