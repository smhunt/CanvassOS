{
  "name": "canvass-web",
  "version": "1.10.0",
  "private": true,
  "description": "Middlesex Centre Canvass — React SPA (Phase 1: login, voter map, stats)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts src/canvass/*.test.ts src/help/*.test.ts src/signs/*.test.ts src/analytics/*.test.ts src/product/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "@tanstack/react-query": "^5.62.0",
    "maplibre-gl": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
